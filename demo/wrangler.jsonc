{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "country-flag-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // The Cloudflare account that holds the demo's domain. Change both lines to deploy your own copy.
  "account_id": "291588c379ca16b199a8c3a686c1f9e6",
  "routes": [{ "pattern": "country-flag.jayshapiro.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
